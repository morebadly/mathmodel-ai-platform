# Copy to .env.local. Never commit or share secrets.
MATHMODEL_DEBUG=1
MATHMODEL_SITE_URL=http://127.0.0.1:8765
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Local development: SQLite in .data; no external email.
MAIL_TRANSPORT=local
DEFAULT_FROM_EMAIL=MathModel AI <dev@example.invalid>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Optional existing HTTP CONNECT proxy; leave blank on servers with direct SMTP.
EMAIL_PROXY_URL=
# Model access is optional; blank key means explicitly unavailable.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Production requires DEBUG=0, a strong secret, HTTPS, PostgreSQL and Redis.
DJANGO_SECRET_KEY=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=

# Trusted local media tools (optional absolute FFmpeg path on Windows).
FFMPEG_PATH=ffmpeg
# MEDIA_MODEL_DIR=/absolute/path/to/small-acoustic-models
MEDIA_TASK_TIMEOUT=180
# Remote user-code execution only. Blank credentials never execute on the business host.
SANDBOX_PROVIDER=e2b
E2B_API_KEY=
E2B_TEMPLATE=
RUNNER_URL=
RUNNER_API_KEY=
MATLAB_AUTHORIZED=0
GUROBI_AUTHORIZED=0
CPLEX_AUTHORIZED=0
SANDBOX_MAX_SECONDS=120
SANDBOX_INPUT_BYTES=10485760
SANDBOX_OUTPUT_BYTES=10485760
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=4096
SANDBOX_CONCURRENCY=2
SANDBOX_DAILY_JOBS=20
# Production secrets can use *_FILE paths; never put real values in this example.
TRUST_HTTPS_PROXY=0
