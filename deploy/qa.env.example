# Private loopback-only QA through an authenticated SSH tunnel. Never expose publicly.
MATHMODEL_DEBUG=1
MATHMODEL_INSTANCE_KIND=test
MATHMODEL_SITE_URL=http://127.0.0.1:9180
MATHMODEL_PRIMARY_URL=http://127.0.0.1:8765
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,web,testserver
MATHMODEL_SESSION_COOKIE_NAME=mathmodel_server_qa_20261024
POSTGRES_DB=mathmodel_qa
POSTGRES_USER=mathmodel_qa
# Safe template default. For real SMTP, configure private EMAIL_* settings and use
# both compose.qa.yaml and compose.qa.smtp.yaml; mount qa-secrets/smtp_password.
# Disable MATHMODEL_QA_ADMIN_MAILBOX when enabling real SMTP. See docs/2026-10-24/10.
MAIL_TRANSPORT=local
MATHMODEL_QA_ADMIN_MAILBOX=1
MATHMODEL_QA_LOOPBACK_SESSIONS=1
DEFAULT_FROM_EMAIL=MathModel AI QA <qa@example.invalid>
SANDBOX_PROVIDER=e2b
SANDBOX_CONCURRENCY=1
SANDBOX_DAILY_JOBS=5
MEDIA_TASK_TIMEOUT=180
MATLAB_AUTHORIZED=0
GUROBI_AUTHORIZED=0
CPLEX_AUTHORIZED=0
