# No secret values in this file. Copy to runtime.env on the server.
MATHMODEL_DEBUG=0
SITE_DOMAIN=mathmodel.example.edu
MATHMODEL_SITE_URL=https://mathmodel.example.edu
DJANGO_ALLOWED_HOSTS=mathmodel.example.edu,127.0.0.1,web
TRUST_HTTPS_PROXY=1
# Enable only after domain owner confirms all subdomains use HTTPS / preload is intended.
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
POSTGRES_DB=mathmodel
POSTGRES_USER=mathmodel
MAIL_TRANSPORT=smtp
DEFAULT_FROM_EMAIL=MathModel AI <noreply@example.edu>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# Do not copy a local 127.0.0.1 proxy to the server. Use direct SMTP by default.
EMAIL_PROXY_URL=
# Set *_FILE only after separately mounting the corresponding secret in compose services.
# EMAIL_HOST_PASSWORD_FILE=/run/secrets/smtp_password
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
# AI_API_KEY_FILE=/run/secrets/ai_key
SANDBOX_PROVIDER=e2b
# E2B_API_KEY_FILE=/run/secrets/e2b_key
E2B_TEMPLATE=
RUNNER_URL=
# RUNNER_API_KEY_FILE=/run/secrets/runner_key
MATLAB_AUTHORIZED=0
GUROBI_AUTHORIZED=0
CPLEX_AUTHORIZED=0
SANDBOX_MAX_SECONDS=120
SANDBOX_INPUT_BYTES=10485760
SANDBOX_OUTPUT_BYTES=10485760
SANDBOX_CPUS=2
SANDBOX_MEMORY_MB=4096
SANDBOX_CONCURRENCY=2
SANDBOX_DAILY_JOBS=20
MEDIA_TASK_TIMEOUT=180
